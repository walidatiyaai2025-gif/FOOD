  "state_definitions": {
    "REUSE": "Existing delivered capability is authoritative; extend only when a concrete gap exists.",
    "PARTIAL": "Useful baseline exists but SaaS-grade lifecycle/operations/UX or integration coverage is incomplete.",
    "GAP": "Required Restaurant SaaS capability is not established by the predecessor program.",
    "LATER": "Architecture must allow it, but it is not required for the first commercial Restaurant SaaS GA."
  },
  "global_rules": [
    "No duplicate menu, order, payment, customer, entitlement, event, workflow or health engines.",
    "Every optional module must be independently entitlement-controlled and safely disableable.",
    "Organization/brand/location scope is enforced server-side.",
    "Arabic/English, RTL/LTR, responsive UX and accessibility are acceptance requirements.",
    "cPanel performance contract and exact-head repository CI are release gates.",
    "Public/published menu/site reads use revisioned cache-friendly read models.",
    "Data is preserved on plan downgrade/suspension unless an explicit retention/offboarding policy says otherwise.",
    "Existing SmartOrdering and Enterprise Core contracts outrank this matrix when implementation details conflict."
  ],
  "waves": [
    {
      "id": 0,
      "name": "SaaS control plane",
      "exit": "Provisioning, plans, billing, onboarding and operator control work without manual DB intervention."
    },
    {
      "id": 1,
      "name": "Menu Studio and digital presence",
      "exit": "Premium bilingual menu/site can be built, previewed, versioned, published and rolled back."
    },
    {
      "id": 2,
      "name": "Commerce and finance hardening",
      "exit": "Orders/payments/refunds/reconciliation are operationally and financially safe."
    },
    {
      "id": 3,
      "name": "Front/back of house",
      "exit": "Tables, reservations/waitlist, KDS and workforce support day-to-day restaurant operation."
    },
    {
      "id": 4,
      "name": "Inventory and supply",
      "exit": "Sales connect to recipes, theoretical usage, stock, food cost and purchasing."
    },
    {
      "id": 5,
      "name": "Omnichannel ecosystem",
      "exit": "Delivery/POS connectors, API and webhooks are resilient and observable."
    },
    {
      "id": 6,
      "name": "Growth and enterprise scale",
      "exit": "CRM/gift cards/automation/franchise controls and multi-location analytics are production grade."
    },
    {
      "id": 7,
      "name": "Independent certification / GA",
      "exit": "Security, tenancy, performance, billing lifecycle, backup/restore and pilot evidence are green."
    }
  ],
