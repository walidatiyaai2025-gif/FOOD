{
  "schema_version": 1,
  "purpose": "Reusable FOODEX business interaction recipes learned from current production journeys. Current source and domain tests remain authoritative.",
  "recipes": [
    {
      "id": "operations-management",
      "required_context": [
        "actor_permission",
        "store_or_channel_scope",
        "record_identity",
        "authoritative_status",
        "available_transitions"
      ],
      "state_machine": [
        "request_or_filter",
        "render_ready_or_empty",
        "action_pending",
        "backend_authoritative_result",
        "reconciled_or_error"
      ],
      "mandatory_states": [
        "ready",
        "empty",
        "validation_error",
        "authorization_error",
        "mutation_pending",
        "reconciled"
      ],
      "primary_interactions": [
        "compact_filters",
        "exact_record_view",
        "overflow_row_actions",
        "authoritative_transition"
      ],
      "post_success": [
        "refresh_exact_record",
        "preserve_filter_context",
        "show_truthful_status"
      ],
      "never": [
        "typed_raw_ids_for_business_users",
        "client_invented_status_transition",
        "multiple_competing_row_buttons"
      ]
    },
    {
      "id": "record-360",
      "required_context": [
        "actor_permission",
        "exact_business_record",
        "related_domains",
        "mutation_permissions",
        "currency_if_financial"
      ],
      "state_machine": [
        "record_load",
        "workspace_ready",
        "focused_domain_action",
        "backend_result",
        "related_domain_reconcile"
      ],
      "mandatory_states": [
        "record_ready",
        "no_related_data",
        "validation_error",
        "authorization_error"
      ],
      "primary_interactions": [
        "tabs_by_business_domain",
        "exact_record_actions",
        "focused_modal_or_inline_editor"
      ],
      "post_success": [
        "reconcile_changed_domain",
        "retain_exact_record_context"
      ],
      "never": [
        "generic_list_redirect_for_manage",
        "raw_internal_ids",
        "unscoped_related_records"
      ]
    },
    {
      "id": "live-monitoring",
      "required_context": [
        "authorized_actor_scope",
        "authoritative_coordinates",
        "last_update_time",
        "entity_type",
        "polling_lifecycle"
      ],
      "state_machine": [
        "initial_load",
        "live_ready",
        "polling_refresh",
        "stale_or_error",
        "recovered"
      ],
      "mandatory_states": [
        "loading",
        "ready",
        "empty",
        "stale",
        "error"
      ],
      "primary_interactions": [
        "map_first",
        "compact_filters",
        "exact_entity_focus",
        "manual_refresh_if_supported"
      ],
      "post_success": [
        "replace_with_new_authoritative_snapshot",
        "retain_last_confirmed_only_when_marked_stale"
      ],
      "never": [
        "fabricated_coordinates",
        "silent_stale_data",
        "stacked_pollers"
      ]
    },
    {
      "id": "transaction-list",
      "required_context": [
        "actor_scope",
        "channel",
        "transaction_identity",
        "authoritative_status",
        "pagination_or_bounded_contract"
      ],
      "state_machine": [
        "loading",
        "ready_or_empty",
        "refresh_or_load_more",
        "detail_open",
        "reconciled"
      ],
      "mandatory_states": [
        "loading",
        "ready",
        "empty",
        "error",
        "refreshing"
      ],
      "primary_interactions": [
        "status_filter_or_tabs",
        "exact_transaction_detail",
        "single_next_action_when_applicable"
      ],
      "post_success": [
        "return_to_same_context",
        "refresh_authoritative_status"
      ],
      "never": [
        "wrapped_reference_identity",
        "client_generated_status_truth",
        "unbounded_history"
      ]
    },
    {
      "id": "commerce-checkout",
      "required_context": [
        "authenticated_buyer",
        "store_context",
        "cart_lines",
        "authoritative_price",
        "availability",
        "payment_options",
        "delivery_context"
      ],
      "state_machine": [
        "cart_review",
        "server_quote_or_validation",
        "checkout_submitting",
        "confirmed_or_recoverable_error"
      ],
      "mandatory_states": [
        "cart_ready",
        "empty_cart",
        "repricing_or_validation_error",
        "submitting",
        "confirmed"
      ],
      "primary_interactions": [
        "edit_quantity",
        "review_totals",
        "choose_authoritative_options",
        "submit_once"
      ],
      "post_success": [
        "open_authoritative_order",
        "clear_or_reconcile_cart"
      ],
      "never": [
        "client_only_pricing",
        "double_submit",
        "auto_submit_without_review"
      ]
    },
    {
      "id": "active-field-delivery",
      "required_context": [
        "driver_channel",
        "assignment_scope",
        "assignment_identity",
        "current_status",
        "allowed_actions",
