      "mandatory_states": [
        "loading",
        "ready",
        "empty",
        "error",
        "offline",
        "stale",
        "action_pending"
      ],
      "primary_interactions": [
        "compact_filters",
        "exact_assignment_action",
        "navigation",
        "deliver_or_fail_with_reason"
      ],
      "post_success": [
        "reload_assignment",
        "remove_or_update_terminal_assignment"
      ],
      "never": [
        "action_on_revoked_assignment",
        "duplicate_transition",
        "silent_polling_failure"
      ]
    },
    {
      "id": "custody-wallet",
      "required_context": [
        "actor_scope",
        "currency",
        "custody_balance",
        "available_to_remit",
