    {
      "id": "authoritative-order-builder",
      "required_context": [
        "customer_scope",
        "product_lines",
        "ordering_increment",
        "payment_method",
        "address_or_warehouse",
        "currency"
      ],
      "state_machine": [
        "draft",
        "editing_lines",
        "authoritative_quote_pending",
        "review_ready",
        "submit_owned_by_review_step"
