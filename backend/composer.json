{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "foodex/platform",
    "type": "project",
    "description": "FOODEX Laravel backend, REST API and role-based management dashboard.",
    "license": "proprietary",
    "require": {
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.10.1",
        "php": "^8.2",
        "tecnickcom/tcpdf": "^6.8"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "lint": [
            "vendor/bin/pint app/Domain/SmartOrdering/RestaurantAnalyticsService.php app/Domain/SmartOrdering/SmartOrderingAnalyticsService.php app/Http/Controllers/Api/SmartOrderingAnalyticsEventController.php app/Domain/SmartOrdering/CartService.php app/Domain/SmartOrdering/CheckoutService.php app/Http/Controllers/Api/SmartOrderingController.php routes/smart-ordering-admin.php routes/smart-ordering-api.php",
            "git --no-pager diff -- app/Domain/SmartOrdering/RestaurantAnalyticsService.php app/Domain/SmartOrdering/SmartOrderingAnalyticsService.php app/Http/Controllers/Api/SmartOrderingAnalyticsEventController.php app/Domain/SmartOrdering/CartService.php app/Domain/SmartOrdering/CheckoutService.php app/Http/Controllers/Api/SmartOrderingController.php routes/smart-ordering-admin.php routes/smart-ordering-api.php"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
