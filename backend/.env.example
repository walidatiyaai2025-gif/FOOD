APP_NAME=FOODEX
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=foodex
DB_USERNAME=foodex
DB_PASSWORD=

# SAFETY: keep false for every persistent/local/production FOODEX database.
# Set true only for a disposable database you explicitly intend to destroy.
FOODEX_ALLOW_DESTRUCTIVE_DB_COMMANDS=false

# Legacy Foodex SQL Server migration source (read-only credentials recommended)
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=1433
LEGACY_DB_DATABASE=Foodex
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_DB_ENCRYPT=no
LEGACY_DB_TRUST_CERTIFICATE=yes

SESSION_DRIVER=file
FILESYSTEM_DISK=local
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=FOODEX

FOODEX_INSTALL_LOCK=storage/app/system/installed.lock
FOODEX_INSTALL_PROGRESS=storage/app/system/install-progress.json

# FOODEX Production Launch Gate (explicit opt-in; provider secrets are never stored here)
FOODEX_PRODUCTION_LAUNCH_ENABLED=false
FOODEX_PRODUCTION_PROVIDER_READY=false

# FOODEX Assistant V1 (deterministic, no external AI)
ASSISTANT_ENABLED=false
ASSISTANT_READ_ONLY=true
ASSISTANT_RETENTION_DAYS=90
ASSISTANT_CACHE_SECONDS=60
ASSISTANT_RATE_LIMIT=30
